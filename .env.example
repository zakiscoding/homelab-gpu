# Copy to .env on GPU PC (never commit .env)
# HF_TOKEN=your-huggingface-token
# WANDB_API_KEY=optional
CHECKPOINT_DIR=C:\Users\zakar\homelab-data\checkpoints
DATASET_DIR=C:\Users\zakar\homelab-data\datasets

# iMac API (Tailscale) — job control plane
API_BASE_URL=http://100.91.113.98
WORKER_API_KEY=must-match-imac-homelab-services-WORKER_API_KEY
WORKER_POLL_SEC=10
# Phase 4 — Redis wake (iMac Redis on Tailscale; poll-only if disabled)
REDIS_URL=redis://100.91.113.98:6379/0
JOB_NOTIFY_ENABLED=true
# Phase 5 — GPU metrics to iMac Pushgateway
PUSHGATEWAY_URL=http://100.91.113.98:9091

# MLflow experiment tracking (iMac :5001 — macOS reserves :5000 for AirPlay)
MLFLOW_TRACKING_URI=http://100.91.113.98:5001
MLFLOW_EXPERIMENT=reaction-vision
MLFLOW_REGISTERED_MODEL=homelab-reaction-fer
MLFLOW_REGISTER_MODEL=1

# Phase 3 training (LLM QLoRA)
TRAIN_MODE=qlora
TRAIN_MAX_STEPS=30
TRAIN_BASE_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
WORKER_TRAIN_TIMEOUT_SEC=1800

# CNN image training (or pass train_mode=cnn in POST /jobs body)
# CNN_EPOCHS=5
# CNN_ARCH=resnet18
# CNN_BATCH_SIZE=32
# CPU feeds GPU — parallel decode/aug (auto ~10 on i7-14700F; override if RAM tight)
# CNN_NUM_WORKERS=10
# CNN_PREFETCH=4
# TRAIN_MAIN_THREADS=4

# Reaction vision HTTP (homelab-web /reactions)
# VISION_SERVE_PORT=8100
# REACTION_CHECKPOINT=C:\Users\zakar\homelab-data\checkpoints\<job-id>\best_model.pt
# REACTION_SERVE_KEY=

# Create folders once:
#   New-Item -ItemType Directory -Force C:\Users\zakar\homelab-data\checkpoints, C:\Users\zakar\homelab-data\datasets
